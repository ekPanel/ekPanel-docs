---
/**
 * The "where the project stands" notice. Its text follows src/data/project.ts, so it changes
 * on every page at once when the project reaches its first release.
 */
import { Aside } from '@astrojs/starlight/components';
import { project } from '~/data/project';

const bn = Astro.currentLocale === 'bn';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const roadmap = `${base}${bn ? '/bn' : ''}/project/roadmap/`;
---

{
	project.stage === 'early' ? (
		<Aside type="caution" title={bn ? 'শুরুর পর্যায়ে' : 'Early development'}>
			{bn ? (
				<>
					ekPanel একটা test server-এ পুরোপুরি কাজ করে, কিন্তু এর প্রথম release এখনো হয়নি। জরুরি কিছু এখনই এতে host করবেন না।{' '}
					<a href={roadmap}>Roadmap</a>-এ দেখুন এরপর কী আসছে।
				</>
			) : (
				<>
					ekPanel works end to end on a test server, but it has not had its first release yet. Do not host anything important
					on it yet. The <a href={roadmap}>roadmap</a> shows what comes next.
				</>
			)}
		</Aside>
	) : (
		<Aside type="tip" title={bn ? `সর্বশেষ release ${project.latestVersion}` : `Latest release: ${project.latestVersion}`}>
			<a href={project.links.changelog}>{bn ? 'কী নতুন এসেছে দেখুন' : 'See what is new'}</a>
		</Aside>
	)
}
