---
/**
 * The "where the project stands" notice. Its text follows src/data/project.ts (stage and
 * latestVersion), so it changes on every page at once.
 */
import { Aside } from '@astrojs/starlight/components';
import { project } from '~/data/project';

const bn = Astro.currentLocale === 'bn';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const roadmap = `${base}${bn ? '/bn' : ''}/project/roadmap/`;
---

{
	project.stage === 'early' ? (
		<Aside type="caution" title={bn ? 'শুরুর পর্যায়ে' : 'Early development'}>
			{bn ? (
				<>
					{project.latestVersion ? `ekPanel v${project.latestVersion} বের হয়েছে, তবে এটা এখনো শুরুর দিকের software: চালিয়ে দেখুন, test করুন, কিন্তু` : 'ekPanel-এর এখনো কোনো release নেই।'}{' '}
					জরুরি কিছু এখনই এতে host করবেন না।{' '}
					<a href={roadmap}>Roadmap</a>-এ দেখুন এরপর কী আসছে।
				</>
			) : (
				<>
					{project.latestVersion
						? `ekPanel v${project.latestVersion} is out, but it is still early software: try it and test it, but do not`
						: 'ekPanel has no release yet. Do not'}{' '}
					host anything important on it yet. The <a href={roadmap}>roadmap</a> shows what comes next.
				</>
			)}
		</Aside>
	) : (
		<Aside type="tip" title={bn ? `সর্বশেষ release ${project.latestVersion}` : `Latest release: ${project.latestVersion}`}>
			<a href={project.links.changelog}>{bn ? 'কী নতুন এসেছে দেখুন' : 'See what is new'}</a>
		</Aside>
	)
}
